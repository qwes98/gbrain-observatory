{
  "name": "gbrain-observatory",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.14.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3443",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3443",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "test:operations": "node --test tests/operations/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && GBRAIN_FIXTURE=success NEXT_PUBLIC_GBRAIN_FIXTURE=success SOURCE_FIXTURE=success npm run build && npm test && npm run test:operations"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
